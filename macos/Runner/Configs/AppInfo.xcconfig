// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = novel_viewer

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.endo5501.novelViewer

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.endo5501. All rights reserved.

// Signing with the developer's own team, kept out of Git like
// ios/Flutter/Local.xcconfig: DEVELOPMENT_TEAM and CODE_SIGN_IDENTITY.
// The keychain entitlement that progress sync and the API key storage need
// (keychain-access-groups) only builds with a development certificate.
#include? "Local.xcconfig"
